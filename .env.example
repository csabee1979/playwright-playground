# Set in shell or CI (optional .env via your own loader)
# Active environment: local | dev | staging | production
TEST_ENV=local

# Override URLs per environment (optional for local; required for dev/staging/production)
# BASE_URL=https://playwright.dev
# API_BASE_URL=https://playwright.dev
# JSON_PLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com
# RESTFUL_API_URL=https://api.restful-api.dev

# Corporate proxy / TLS inspection (local only)
# IGNORE_HTTPS_ERRORS=true

# Optional authenticated restful-api.dev tests
# Get API key after signing up at https://restful-api.dev/
# RESTFUL_API_KEY=

# Regular user (restfulApiAsUser fixture):
# RESTFUL_API_USER_ID=user-001
# RESTFUL_API_USER_NAME=your_user_name
# RESTFUL_API_USER_EMAIL=your_user@example.com
# RESTFUL_API_USER_PASSWORD=

# Admin user (restfulApiAsAdmin fixture):
# RESTFUL_API_ADMIN_ID=admin-001
# RESTFUL_API_ADMIN_NAME=your_admin_name
# RESTFUL_API_ADMIN_EMAIL=your_admin@example.com
# RESTFUL_API_ADMIN_PASSWORD=
