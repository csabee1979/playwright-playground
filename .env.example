# Set in shell or CI (optional .env via your own loader)
# Active environment: local | dev | staging | production
TEST_ENV=dev

# Application URLs
DEV_PLAYWRIGHT_DOCS_BASE_URL=https://playwright.dev
DEV_PLAYWRIGHT_DOCS_API_URL=https://playwright.dev
DEV_LEETCODE_BASE_URL=https://letcode.in
DEV_RESTFUL_API_URL=https://api.restful-api.dev # website: https://restful-api.dev/
DEV_JSON_PLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com

STAGING_PLAYWRIGHT_DOCS_BASE_URL=a
STAGING_PLAYWRIGHT_DOCS_API_URL=a
STAGING_LEETCODE_BASE_URL=a
STAGING_RESTFUL_API_URL=a
STAGING_JSON_PLACEHOLDER_BASE_URL=a

PRODUCTION_PLAYWRIGHT_DOCS_BASE_URL=a
PRODUCTION_PLAYWRIGHT_DOCS_API_URL=a
PRODUCTION_LEETCODE_BASE_URL=a
PRODUCTION_RESTFUL_API_URL=a
PRODUCTION_JSON_PLACEHOLDER_BASE_URL=a

# Corporate proxy / TLS inspection (local only)
# IGNORE_HTTPS_ERRORS=true